DATABASE_URL=sqlite:///./obligo.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
OBLIGO_ENV=development
# Set a long, random secret locally; never commit it.
MCP_BEARER_TOKEN=
WORKSPACE_TIMEZONE=UTC
# For public MCP, replace localhost defaults with exact allowed public hosts and origins.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
# Set to the public HTTPS MCP endpoint only after the backend is deployed.
PUBLIC_MCP_URL=
